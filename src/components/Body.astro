---
import type { Line } from "../lib/notion";
import LinkedText from "./LinkedText.astro";
interface Props {
  lines: Line[];
}
const { lines } = Astro.props;
const groups: { kind: Line["kind"]; values: Line[] }[] = [];
for (const line of lines) {
  const { kind } = line;
  const last = groups.at(-1);
  if (
    (kind === "bulleted_list_item" || kind === "numbered_list_item") &&
    last?.kind === kind
  )
    last.values.push(line);
  else groups.push({ kind, values: [line] });
}
---

<div class="prose">
  {groups.map(({ kind, values }) => {
    if (kind === "divider") return <hr />;
    if (kind.startsWith("heading")) return <h2><LinkedText line={values[0]} /></h2>;
    if (kind === "bulleted_list_item")
      return (
        <ul>
          {values.map((v) => (
            <li><LinkedText line={v} /></li>
          ))}
        </ul>
      );
    if (kind === "numbered_list_item")
      return (
        <ol>
          {values.map((v) => (
            <li><LinkedText line={v} /></li>
          ))}
        </ol>
      );
    if (kind === "quote") return <blockquote><LinkedText line={values[0]} /></blockquote>;
    return <p><LinkedText line={values[0]} /></p>;
  })}
</div>
