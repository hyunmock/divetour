---
import type { SiteContent } from "../lib/notion";
interface Props {
  heading?: "h2" | "h3";
  items: SiteContent["media"];
}
const { items, heading: Heading = "h2" } = Astro.props;
---

{items.length ? (
  <>
    <p>MYBOX 암호는 카카오톡 팀 채널에서 확인해 주세요.</p>
    <div class="grid">
      {items.map((item) => (
        <article class="card">
          <Heading>{item.title}</Heading>
          <a href={item.url} rel="nofollow noopener noreferrer" target="_blank">
            MYBOX 폴더 열기 (새 창)
          </a>
        </article>
      ))}
    </div>
  </>
) : (
  <p class="empty">현재 공개된 사진·영상이 없습니다.</p>
)}
