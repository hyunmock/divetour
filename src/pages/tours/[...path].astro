---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Body from "../../components/Body.astro";
import TourTable from "../../components/TourTable.astro";
import { content, href, displayDate } from "../../lib/content";
export async function getStaticPaths() {
  const { tours } = await content();
  return [undefined, "upcoming", "completed", ...tours.map((t) => t.slug)].map(
    (path) => ({ params: { path } }),
  );
}
const { tours } = await content();
const path = Astro.params.path;
const tour = tours.find((t) => t.slug === path);
const filters = [
  ["전체 투어", ""],
  ["예정 투어", "upcoming"],
  ["완료 투어", "completed"],
];
const title = tour?.title ?? filters.find(([, v]) => v === (path ?? ""))![0];
const list = tours.filter((t) =>
  path === "completed"
    ? t.state === "완료"
    : path === "upcoming"
      ? t.state !== "완료"
      : true,
);
---

<BaseLayout title={title}>
  <h1>{title}</h1>
  {tour ? (
    <>
      <p>
        {[
          tour.state,
          tour.location,
          tour.dates ? displayDate(tour.dates.start) : "일정 미정",
          tour.dates?.end && displayDate(tour.dates.end),
        ]
          .filter(Boolean)
          .join(" · ")}
      </p>
      <Body lines={tour.body} />
      {tour.body.some((line) => line.parts?.some((part) => part.href && new URL(part.href).hostname === "mybox.naver.com")) && (
        <p>MYBOX 암호는 카카오톡 팀 채널에서 확인해 주세요.</p>
      )}
      <a href={href("tours/")}>투어 목록으로</a>
    </>
  ) : (
    <>
      <nav class="tabs" aria-label="투어 분류">
        {filters.map(([label, v]) => (
          <a
            href={href("tours/" + (v ? v + "/" : ""))}
            aria-current={v === (path ?? "") ? "page" : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
      {list.length ? <TourTable tours={list} /> : (
        <p class="empty">현재 공개된 투어가 없습니다.</p>
      )}
    </>
  )}
</BaseLayout>
