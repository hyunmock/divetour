---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TourCard from "../../components/TourCard.astro";
import Body from "../../components/Body.astro";
import MediaList from "../../components/MediaList.astro";
import { content, href, displayDate } from "../../lib/content";
export async function getStaticPaths() {
  const { tours } = await content();
  return [undefined, "upcoming", "completed", ...tours.map((t) => t.slug)].map(
    (path) => ({ params: { path } }),
  );
}
const { tours, media } = await content();
const path = Astro.params.path;
const tour = tours.find((t) => t.slug === path);
const filters = [
  ["전체 투어", ""],
  ["예정 투어", "upcoming"],
  ["완료 투어", "completed"],
];
const title = tour?.title ?? filters.find(([, v]) => v === (path ?? ""))![0];
const list = tours.filter((t) =>
  path === "completed"
    ? t.state === "완료"
    : path === "upcoming"
      ? t.state !== "완료"
      : true,
);
---

<BaseLayout title={title}>
  <h1>{title}</h1>
  {tour ? (
    <>
      <p>
        {[
          tour.state,
          tour.location,
          tour.dates ? displayDate(tour.dates.start) : "일정 미정",
          tour.dates?.end && displayDate(tour.dates.end),
        ]
          .filter(Boolean)
          .join(" · ")}
      </p>
      <Body lines={tour.body} />
      {tour.state === "완료" && tour.archive && (
        <section>
          <h2>사진·영상</h2>
          <MediaList
            heading="h3"
            items={media.filter((m) => m.tour === tour.slug)}
          />
        </section>
      )}
      <a href={href("tours/")}>투어 목록으로</a>
    </>
  ) : (
    <>
      <nav class="tabs" aria-label="투어 분류">
        {filters.map(([label, v]) => (
          <a
            href={href("tours/" + (v ? v + "/" : ""))}
            aria-current={v === (path ?? "") ? "page" : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
      {list.length ? (
        <div class="grid">
          {list.map((t) => (
            <TourCard tour={t} />
          ))}
        </div>
      ) : (
        <p class="empty">현재 공개된 투어가 없습니다.</p>
      )}
    </>
  )}
</BaseLayout>
