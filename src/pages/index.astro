---
import BaseLayout from "../layouts/BaseLayout.astro";
import TourTable from "../components/TourTable.astro";
import { content, href } from "../lib/content";
const upcoming = (await content()).tours.filter((t) => t.state !== "완료");
---

<BaseLayout title="홈">
  <section class="hero">
    <div>
      <h1>다이빙투어 모임</h1>
      <p>투어 일정과 참여 방법을 확인하세요.</p>
      <a class="button" href={href("tours/upcoming/")}>
        투어 둘러보기 →
      </a>
    </div>
  </section>
  <section>
    <div class="section-head">
      <h2>예정 투어</h2>
      <a href={href("tours/upcoming/")}>전체 보기</a>
    </div>
    {upcoming.length ? (
      <TourTable tours={upcoming} />
    ) : (
      <p class="empty">현재 공개된 예정 투어가 없습니다.</p>
    )}
  </section>
</BaseLayout>
